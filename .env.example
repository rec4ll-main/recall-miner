# Recall Miner - Required Environment Variables
# Copy to .env in this repository and fill in the values before starting.
# Public template: required secrets are intentionally empty. See SETUP.md.
# Each independent miner should use a unique COMPOSE_PROJECT_NAME and fresh secrets.
# COMPOSE_PROJECT_NAME=recall-miner-your-instance

# Recall application API base for signed registration and heartbeats.
RECALL_API_URL=https://rec4ll.com/api

# Public address of the Recall API's signing key (not a secret). The miner trusts only
# this signer for probes and uses it as the heartbeat audience. Mainnet (finney netuid 31)
# value below; same name and value as the API's own setting.
# Compose passes it through only when set; an explicit empty value fails startup.
# Renamed from APPLICATION_PROBER_HOTKEY_SS58; the old name now fails startup.
# Required: there is no fallback identity. VALIDATOR_HOTKEY_SS58 was removed and fails
# startup if it is present at all (even empty); delete it from older .env files.
API_SIGNING_HOTKEY_SS58=5ECDAred992gLh55nJ7PxQDtihHXy5qZZXuCkqLVJdmDsrYw

# Miner hotkey URI or secret seed (hex)
MINER_HOTKEY_URI=

# SS58 format (42 for default)
SS58_FORMAT=42

# Replace with this miner's public HTTPS endpoint; match MINER_HOST_PORT below.
MINER_API_URL=https://miner.example.com:6001

# Private random key shared only within THIS miner stack.
# Generate locally, e.g. openssl rand -hex 32; never paste a real key into chat.
# Do not reuse the Recall API/master-validator key, or give this to validators.
# Compose injects it into miner, db-service, GPU proxy and CPU proxy only.
# INTERNAL_API_KEY (from MINER_INTERNAL_API_KEY in compose) authenticates the
# sidecar control plane, which shares the public listener. Outside
# ENVIRONMENT=dev/test the miner fails startup if it is empty or a known
# placeholder (local-miner-internal-key / change-me / changeme / placeholder /
# local-dev / local-api). Replace with a long random value before any public
# deployment.
MINER_INTERNAL_API_KEY=

# Port mappings (optional)
MINER_HOST_PORT=6001
# vLLM is not published on the host.
# GPU embeddings go through the authenticated model proxy.
# Do not publish host port 6000.

# vLLM model settings
VLLM_MODEL=BAAI/bge-small-en-v1.5
VLLM_GPU_MEMORY_UTILIZATION=0.12
VLLM_MAX_MODEL_LEN=512

# CPU inference settings (fallback when GPU unavailable)
MINER_MODEL_DEVICE=cpu
MINER_EMBED_MODEL=BAAI/bge-small-en-v1.5
MINER_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2
# Generation runs only through the Chutes sidecar (docs/GENERATION_CHUTES.md).
# Keep GEN_OPENAI_URL empty: if it is set, the inference service refuses generation
# (embedding and rerank keep serving) and never calls that URL.
# MINER_GEN_MODEL is legacy; it does not enable or advertise generation.
MINER_GEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GEN_OPENAI_URL=
# CPU inference service only; it never generates. The Chutes sidecar does not read this.
GEN_OPENAI_TIMEOUT_SECONDS=60

# Chutes generation (profile: chutes)
# Used only by `docker compose --profile chutes up -d` (docs/GENERATION_CHUTES.md);
# the default stack ignores these. The API key is never set here: the sidecar reads
# it from the file api-key in CHUTES_KEY_DIR (root:1001, 0640; directory 0750).
# Exact concrete Chutes model ID (recommended default below). Compose sends this one
# value to the sidecar, the generation proxy (MODELS) and the miner; keep it set here.
CHUTES_MODEL=Qwen/Qwen3.8-27B-TEE
# Existing host directory holding the api-key file; mounted read-only.
CHUTES_KEY_DIR=
# The sidecar keeps its ledger in the Docker volume chutes-state, created automatically.
# Optional, advanced: CHUTES_STATE_DIR=/absolute/path keeps it in that host directory instead
# (writable by UID 1001); CHUTES_LEDGER_ID=<uuid> pins the ledger (docs/GENERATION_CHUTES.md).
# How many generation requests your miner sends to Chutes at once (1-16, default 4);
# match it to your Chutes plan.
# CHUTES_MAX_CONCURRENT=4
# Catalog embedding model ids this miner serves. Comma-separated.
# Unspecified databases use bge-small-en-v1.5. Declare only models this host serves.
# BAAI/bge-small-en-v1.5 is bge-small-en-v1.5 (CPU-friendly default).
MINER_EMBEDDING_MODELS=bge-small-en-v1.5
MINER_EMBED_BATCH_SIZE=64
MINER_RERANK_BATCH_SIZE=32

# Sidecar registration interval (seconds)
SIDECAR_REGISTRATION_INTERVAL_SECONDS=10

# Sidecar auto-register with miner on start (db-service / model-proxy)
REGISTER_ON_START=true

# Vector DB engine (db-service sidecar)
# Mainnet v1 is Qdrant-only. DB_ENGINE defaults to `qdrant`; the Milvus and
# pgvector backends are allowed only in ENVIRONMENT=dev/test OR when the
# explicit ALLOW_UNSUPPORTED_DB_ENGINE=true override is passed to db-service.
# Keep that override off for public operation. An unknown DB_ENGINE always fails
# startup; it never silently falls back to Milvus.
DB_ENGINE=qdrant
# ALLOW_UNSUPPORTED_DB_ENGINE=false

# Docker image settings (optional)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Runtime safety label, not chain selection. Use production for public operation.
# prod/mainnet/unset also keep guards enabled; only dev/test are exempt.
# Runtime environment
# ENVIRONMENT guard: unset ENVIRONMENT is treated as NON-dev (armed), so a
# deployment that configures nothing is still guarded. Only an explicit
# ENVIRONMENT=dev or ENVIRONMENT=test is exempt. In any non-dev environment
# the miner fails fast at startup if the hotkey secret is empty or a known
# placeholder (change-me / local-dev / local-miner / placeholder / //Alice /
# //Bob / //RecallMiner), or if INTERNAL_API_KEY is empty or a known
# placeholder.
ENVIRONMENT=production

# Network contract
# Deployment metadata only in this Go miner: NETUID does not select/register a chain.
# Register the actual signing hotkey on finney subnet 31 using the operator wallet.
NETUID=31

# Response signing: miner signs responses to validator-authenticated
# requests when RESPONSE_SIGNING_ENABLED=true. The subnet id (NETUID above)
# is NOT included in the response signature; request-uuid binding alone
# prevents cross-request replay.
GENERATION_ENABLED=false

# Advanced direct-process defaults below require a Compose environment override.
# Pre-auth body cap (DoS hardening): request bodies larger than MAX_BODY_BYTES
# are rejected with a deterministic 413 before auth verification on all
# routes. Default 1048576 (1 MiB).
# MAX_BODY_BYTES=1048576

# HTTP server timeouts (seconds), mirroring the web API values.
# SERVER_READ_TIMEOUT_SECONDS=30
# SERVER_WRITE_TIMEOUT_SECONDS=120
# SERVER_IDLE_TIMEOUT_SECONDS=120

# Native TLS: when TLS_ENABLED=true the miner's public listener serves
# TLS only (no plaintext fallback) and registers its SPKI pin with the
# Recall API. TLS_CERT_FILE/TLS_KEY_FILE point at an existing cert+key pair;
# when TLS_AUTO_GENERATE=true (default) and the files are absent a self-signed
# ECDSA P-256 cert is generated and persisted. Startup fails fast if
# TLS_AUTO_GENERATE=false and the cert/key files are missing. MINER_API_URL
# below must advertise the https:// URL once TLS is enabled.
TLS_ENABLED=true
# TLS_CERT_FILE=/var/lib/recall-miner/certs/miner-cert.pem
# TLS_KEY_FILE=/var/lib/recall-miner/certs/miner-key.pem
# TLS_AUTO_GENERATE=true
# TLS_SAN_HOSTS=miner
# When TLS_ENABLED=true with Compose, also set:
SIDECAR_MINER_API_URL=https://miner:8001
MINER_TLS_CA_FILE=/var/lib/recall-miner/certs/miner-cert.pem
# and advertise a public https:// MINER_API_URL.
# MINER_REGISTRATION_INTERVAL_SECONDS=0

# Always set MINER_API_URL explicitly. The MINER_EXTERNAL_IP / auto-advertise
# helpers are not wired into the current registration path; see docs/ENVIRONMENT.md.

# Root .env is Compose interpolation input; it is not automatically forwarded
# wholesale into containers. See docs/ENVIRONMENT.md before adding optional flags.

# Overload controls (see docs/ENVIRONMENT.md). Defaults are
# generous; 0 disables request/concurrency controls (table size 0 uses its default;
# overflow budget 0 refuses untracked sources at saturation). Refusals are 503 + Retry-After, except
# the pre-auth failure guard which answers 429. Requests signed as the Recall API are never
# refused by that guard; IPv6 clients are counted per /64.
# RATE_LIMIT_AUTH_FAILURES_PER_MIN=60
# RATE_LIMIT_VALIDATOR_PER_MIN=3000
# RATE_LIMIT_DB_CREATE_PER_MIN=20
# RATE_LIMIT_AUTH_FAILURE_TABLE_SIZE=10000
# RATE_LIMIT_AUTH_FAILURE_OVERFLOW_PER_MIN=600
# CIDRs or IPs of your own reverse proxies; leave empty for direct TLS (the default).
# RATE_LIMIT_TRUSTED_PROXIES=
# EMBED_MAX_INFLIGHT=64
# RERANK_MAX_INFLIGHT=32
# QUERY_MAX_INFLIGHT=128
# STORE_MAX_INFLIGHT=128
# GENERATE_MAX_INFLIGHT=8
# Seconds the miner waits for one generated answer. The Recall API scores answers that arrive
# within 60 s (it waits 90 s); the default leaves 2 s for the network.
# GENERATION_BACKEND_TIMEOUT_SECONDS=58
